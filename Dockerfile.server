FROM golang:1.22-alpine AS build

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -o server ./cmd/server

# ---- runtime image ----
FROM alpine:3.19

WORKDIR /app
COPY --from=build /app/server .

EXPOSE 50051

CMD ["./server"]
